# Copy to backend/.env and fill in. backend/.env is gitignored.

# OpenAI — the shared agent's model (text + Live delegation backend) and the Live voice model.
# Needed from build slice 2.
OPENAI_API_KEY=
# Placeholder id; confirm the current best fast model.
AGENT_MODEL=openai:gpt-6-sol
# live | realtime (fallback)
VOICE_LAYER=live
OPENAI_LIVE_MODEL=gpt-live-1
# Empty = the agent's own model (recommended).
OPENAI_LIVE_BACKEND_MODEL=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# OpenRouter — auxiliary only (one-shot tasks, harness personas). Optional.
OPENROUTER_API_KEY=

# Storage. Slice 1.
DATABASE_URL=sqlite+aiosqlite:///./onboarding.db
# Fernet key for encrypting integration credentials. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# Google OAuth (openid, email, profile). Slice 4.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Public base URL for links the agent sends by text.
APP_BASE_URL=http://localhost:8000

# Optional
JEV_API_KEY=
LOGFIRE_TOKEN=
DEBUG=false
