# Copy to backend/.env and fill in. backend/.env is gitignored.

# OpenAI: the text model, the voice model, and transcription.
OPENAI_API_KEY=
AGENT_MODEL=gpt-6-sol
AGENT_REASONING_EFFORT=low
OPENAI_LIVE_MODEL=gpt-live-1
# Empty = Live's default backend model.
OPENAI_LIVE_BACKEND_MODEL=
TRANSCRIBE_MODEL=gpt-transcribe

# OpenRouter: enables Jev for routing judgment calls. Without it, fixed fallbacks are used.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13

DATABASE_URL=sqlite+aiosqlite:///./onboarding.db
# Public base URL, for links the agent texts (e.g. the Gmail link).
APP_BASE_URL=http://localhost:8000

# Google sign-in (Gmail + Calendar). A Google OAuth "Web application" client in Testing mode, with this
# redirect URI registered: {APP_BASE_URL}/api/auth/google/callback. Only the project's test
# users can connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Fernet key that encrypts stored Google tokens. Make one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=
