# Copy to backend/.env and fill in. backend/.env is gitignored.

# OpenAI — Realtime voice only (creates the call and opens the sideband). Needed from build slice 3.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# OpenRouter — text agent and every other model call. Needed from build slice 2.
OPENROUTER_API_KEY=

# Storage. Slice 1.
DATABASE_URL=sqlite:///./onboarding.db
# Fernet key for encrypting integration credentials. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# Google OAuth (openid, email, profile). Slice 4.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Public base URL for links the agent sends by text.
APP_BASE_URL=http://localhost:8000

# Optional
JEV_API_KEY=
LOGFIRE_TOKEN=
DEBUG=false
