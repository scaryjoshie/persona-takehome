# A call: GPT-Live talks, the Back Office acts. Render: d2 call-architecture.d2 call-architecture.svg
# Styling follows cado's tools/depgraph/arch.d2: white leaves on tinted trays, slate edges.
vars: {
  d2-config: { layout-engine: elk; theme-id: 0; pad: 40 }
}
direction: right

classes: {
  leaf: { style: { fill: "#FFFFFF"; stroke: "#CBD5E1"; stroke-width: 1; border-radius: 6; font-color: "#475569" } }
  flow: { style: { fill: "#FFEDD5"; stroke: "#EA580C"; stroke-width: 2; border-radius: 6; font-color: "#7C2D12"; bold: true } }
  agent: { style: { fill: "#DBEAFE"; stroke: "#2563EB"; stroke-width: 2; border-radius: 6; font-color: "#1E3A8A" } }
  jev: { style: { fill: "#F5F3FF"; stroke: "#8B5CF6"; stroke-width: 2; border-radius: 6; font-color: "#6D28D9"; italic: true } }
  store: { shape: cylinder; style: { fill: "#F1F5F9"; stroke: "#64748B"; stroke-width: 2; font-color: "#0F172A" } }
  domain: { style: { fill: "#FBFCFE"; stroke: "#64748B"; stroke-width: 2; border-radius: 16; font-color: "#0F172A"; bold: true; font-size: 20 } }
  layer: { style: { fill: "#F1F5F9"; stroke: "#E2E8F0"; stroke-width: 1; border-radius: 10; font-color: "#64748B"; font-size: 16; bold: true } }
  wire: { style: { stroke: "#64748B"; stroke-width: 2 } }
  into: { style: { stroke: "#8B5CF6"; stroke-width: 3 } }
}

user: "User Side" {
  class: layer
  speaks: "User speaks" { class: leaf }
  texts: "User texts" { class: leaf }
}

openai: "OpenAI" {
  class: layer
  live: "GPT-Live Session" { class: agent }
}

backend: "Backend" {
  class: domain
  transcript: "Transcript\n(spoken order)" { class: flow }
  commit: "Jev Commit\nhead" { class: jev }
  office: "Back Office\n(two keys)" { class: agent }
  store: "Context Store" { class: store }
  brief: "Brief" { class: flow }
  timers: "Timers" { class: leaf }

  transcript -> office: "turns" { class: wire }
  transcript -> commit: { class: wire }
  commit -> office: "act now" { class: wire }
  office -> store: { class: wire }
  store -> brief: { class: wire }
}

out: "External" {
  class: layer
  agent_texts: "Agent Texts" { class: leaf }
  google: "Gmail + Calendar" { class: leaf }
}

user.speaks <-> openai.live: "audio" { class: wire }
user.texts -> backend.store: { class: wire }
openai.live -> backend.transcript: "We receive: transcripts" { class: wire }
backend.office -> out.agent_texts: { class: wire }
backend.office -> out.google: { class: wire }

# written live <- source so the session stays between the user and the backend
openai.live <- backend.brief: "instructions" { class: into }
openai.live <- backend.office: "context" { class: into }
openai.live <- backend.timers: "commentary" { class: into }
