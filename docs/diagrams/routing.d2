# Event routing. Render: d2 routing.d2 routing.svg
# Styling follows cado's tools/depgraph/arch.d2: white leaves on tinted trays, slate edges.
vars: {
  d2-config: { layout-engine: elk; theme-id: 0; pad: 40 }
}
direction: down

classes: {
  leaf: { style: { fill: "#FFFFFF"; stroke: "#CBD5E1"; stroke-width: 1; border-radius: 6; font-color: "#475569" } }
  flow: { style: { fill: "#FFEDD5"; stroke: "#EA580C"; stroke-width: 2; border-radius: 6; font-color: "#7C2D12"; bold: true } }
  agent: { style: { fill: "#DBEAFE"; stroke: "#2563EB"; stroke-width: 2; border-radius: 6; font-color: "#1E3A8A" } }
  jev: { style: { fill: "#F5F3FF"; stroke: "#8B5CF6"; stroke-width: 2; border-radius: 6; font-color: "#6D28D9"; italic: true } }
  store: { shape: cylinder; style: { fill: "#F1F5F9"; stroke: "#64748B"; stroke-width: 2; font-color: "#0F172A" } }
  domain: { style: { fill: "#FBFCFE"; stroke: "#64748B"; stroke-width: 2; border-radius: 16; font-color: "#0F172A"; bold: true; font-size: 20 } }
  layer: { style: { fill: "#F1F5F9"; stroke: "#E2E8F0"; stroke-width: 1; border-radius: 10; font-color: "#64748B"; font-size: 16; bold: true } }
  wire: { style: { stroke: "#64748B"; stroke-width: 2 } }
  passive: { style: { stroke: "#94A3B8"; stroke-width: 2; stroke-dash: 4 } }
}

external: "External" {
  class: layer
  event: "External Event" { class: leaf }
}

user: "User Side" {
  class: layer
  texts: "User texts" { class: leaf }
  speaks: "User speaks" { class: leaf }
}

backend: "Backend" {
  class: domain
  delta: "Delta Created" { class: flow }
  store: "Context Store" { class: store }
  router: "Router" { class: flow }
  jev_text: "Jev Text\nfiltration head" { class: jev }
  jev_voice: "Jev Voice\nfiltration head" { class: jev }
  text: "Text Handler" { class: agent }
  voice: "Voice Handler" { class: agent }
  note: "Dashed lines indicate passive store:\nthe event is saved, not routed to an agent" {
    shape: text
    style.font-color: "#64748B"
    style.font-size: 14
  }

  delta -> store: { class: wire }
  store -> router: { class: wire }
  router -> jev_text: "text" { class: wire }
  router -> jev_voice: "call" { class: wire }
  jev_text -> text: { class: wire }
  jev_voice -> voice: { class: wire }
  # written store <- handler so these don't change the left-to-right order
  store <- text: "texts" { class: passive }
  store <- voice: "transcripts, actions" { class: passive }
}

openai: "OpenAI" {
  class: layer
  live: "GPT-Live Session" { class: agent }
}

external.event -> backend.delta: { class: wire }
user.texts -> backend.delta: { class: wire }
user.speaks <-> openai.live: "audio" { class: wire }
backend.voice <-> openai.live: "We receive: transcripts\nWe send: instructions, notes" { class: wire }

why: |md
  ### Why events

  **Everything is event-driven and immediately persisted.** \
  Events are the unit by which actions are handled. Context is \
  mostly read in a stateless manner.

  - **Probably scalable:** this should scale well on serverless, \
    since any instance can handle an event: actions are a function \
    of context + the most recent event + active processes (held \
    statefully now, would move to Redis).
  - **Easy routing:** events live in one stream, so routing to the \
    text or call handler is simple control flow.
  - **Efficient passing of event deltas:** filtering and \
    categorizing events with Jev is an extremely cheap way to \
    decide whether the expensive work of writing texts should be \
    interrupted and restarted, or whether to prompt it after or \
    just add to context.
  - **Very extendable:** more than user texts and calls can come \
    in. Calendar notifications, updates from background agents, or \
    things the agent is monitoring can stream through the same \
    pipeline; Gmail sign-ups already do.

  At scale some tiered system may be needed, where events to the \
  main stream are heavily summarized, but this design is \
  reasonable for onboarding.

  GPT-Live audio does not route through event deltas; its \
  transcripts and actions do.
| {
  near: center-right
}
