# How an event is routed. Render: d2 routing.d2 routing.svg
# Styling follows cado's tools/depgraph/arch.d2: white leaves on tinted trays, slate edges.
vars: {
  d2-config: { layout-engine: elk; theme-id: 0; pad: 40 }
}
direction: down

classes: {
  leaf: { style: { fill: "#FFFFFF"; stroke: "#CBD5E1"; stroke-width: 1; border-radius: 6; font-color: "#475569" } }
  flow: { style: { fill: "#FFEDD5"; stroke: "#EA580C"; stroke-width: 2; border-radius: 6; font-color: "#7C2D12"; bold: true } }
  agent: { style: { fill: "#DBEAFE"; stroke: "#2563EB"; stroke-width: 2; border-radius: 6; font-color: "#1E3A8A" } }
  jev: { style: { fill: "#F5F3FF"; stroke: "#8B5CF6"; stroke-width: 2; border-radius: 6; font-color: "#6D28D9"; italic: true } }
  store: { shape: cylinder; style: { fill: "#F1F5F9"; stroke: "#64748B"; stroke-width: 2; font-color: "#0F172A" } }
  domain: { style: { fill: "#FBFCFE"; stroke: "#64748B"; stroke-width: 2; border-radius: 16; font-color: "#0F172A"; bold: true; font-size: 20 } }
  layer: { style: { fill: "#F1F5F9"; stroke: "#E2E8F0"; stroke-width: 1; border-radius: 10; font-color: "#64748B"; font-size: 14 } }
  wire: { style: { stroke: "#64748B"; stroke-width: 2 } }
}

events: "Every event" {
  class: layer
  grid-columns: 5
  texts: "A text\nfrom them" { class: leaf }
  call: "A line said\non a call" { class: leaf }
  tools: "Something the\nagent did" { class: leaf }
  timers: "A timer\nfiring" { class: leaf }
  google: "Google\nconnecting" { class: leaf }
}

save: "Save it" { class: flow }
log: "Event log" { class: store }
route: "Who has the floor?" { class: flow }

text: "No call: text" {
  class: domain
  check: "Jev: reply now,\nor wait?" { class: jev }
  agent: "Text agent" { class: agent }
  out: "Texts to them" { class: leaf }
  check -> agent -> out: { class: wire }
}

voice: "On a call: voice" {
  class: domain
  verb: "Jev: interrupt,\nabsorb or defer?" { class: jev }
  live: "GPT-Live" { class: agent }
  out: "Speech" { class: leaf }
  verb -> live -> out: { class: wire }
}

events -> save: { class: wire }
save -> log: { class: wire }
save -> route: { class: wire }
route -> text: { class: wire }
route -> voice: { class: wire }
