          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "turn_id": {
            "title": "Turn Id",
            "type": "string"
          },
          "inferred": {
            "default": true,
            "title": "Inferred",
            "type": "boolean"
          }
        },
        "required": ["kind", "speaker", "text", "turn_id", "inferred"],
        "title": "VoiceUtterance",
        "type": "object"
      },
      "WireEvent": {
        "description": "The event envelope as the browser sees it, with the payload typed as the full union.",
        "properties": {
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "ts": {
            "format": "date-time",
            "title": "Ts",
            "type": "string"
          },
          "origin": {
            "$ref": "#/$defs/Origin"
          },
          "channel": {
            "$ref": "#/$defs/Channel"
          },
          "payload": {
            "discriminator": {
              "mapping": {
                "agent_message": "#/$defs/AgentMessage",
                "call": "#/$defs/CallEvent",
                "decision": "#/$defs/Decision",
                "gmail": "#/$defs/GmailEvent",
                "graduated": "#/$defs/Graduated",
                "slot_changed": "#/$defs/SlotChanged",
                "tool_call": "#/$defs/ToolCall",
                "typing": "#/$defs/Typing",
                "user_message": "#/$defs/UserMessage",
                "voice_utterance": "#/$defs/VoiceUtterance"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/UserMessage"
              },
              {
                "$ref": "#/$defs/AgentMessage"
              },
              {
                "$ref": "#/$defs/Typing"
              },
              {
                "$ref": "#/$defs/VoiceUtterance"
              },
              {
                "$ref": "#/$defs/ToolCall"
              },
              {
                "$ref": "#/$defs/SlotChanged"
              },
              {
                "$ref": "#/$defs/Graduated"
              },
              {
                "$ref": "#/$defs/CallEvent"
              },
              {
                "$ref": "#/$defs/GmailEvent"
              },
              {
                "$ref": "#/$defs/Decision"
              }
            ],
            "title": "Payload"
          }
        },
        "required": ["seq", "ts", "origin", "channel", "payload"],
        "title": "WireEvent",
        "type": "object"
      }
    },
    "discriminator": {
      "mapping": {
        "call": "#/$defs/CallMessage",
        "event": "#/$defs/EventMessage",
        "partial": "#/$defs/TranscriptPartial",
        "slots": "#/$defs/SlotsMessage",
        "snapshot": "#/$defs/Snapshot",
        "typing": "#/$defs/TypingMessage"
      },
      "propertyName": "type"
    },
    "oneOf": [
      {
        "$ref": "#/$defs/Snapshot"
      },
      {
        "$ref": "#/$defs/EventMessage"
      },
      {
        "$ref": "#/$defs/SlotsMessage"
      },
      {
        "$ref": "#/$defs/CallMessage"
      },
      {
        "$ref": "#/$defs/TypingMessage"
      },
      {
        "$ref": "#/$defs/TranscriptPartial"
      }
    ]
  },
