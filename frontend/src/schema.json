            "title": "Reason"
          },
          "call_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Call Id"
          },
          "initiated_by": {
            "anyOf": [
              {
                "$ref": "#/$defs/Initiator"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Started At"
          },
          "ended_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ended At"
          }
        },
        "required": ["phase", "reason", "call_id", "initiated_by", "started_at", "ended_at"],
        "title": "CallState",
        "type": "object"
      },
      "CallTransition": {
        "enum": ["ringing", "connecting", "connected", "declined", "failed", "ended"],
        "title": "CallTransition",
        "type": "string"
      },
      "Channel": {
        "enum": ["text", "voice", "system"],
        "title": "Channel",
        "type": "string"
      },
      "DecidedBy": {
        "enum": ["fixed", "default", "jev", "model"],
        "title": "DecidedBy",
        "type": "string"
      },
      "Decision": {
        "additionalProperties": false,
        "description": "Logged for every routed event. The debug panel and the harness read these.",
        "properties": {
          "kind": {
            "const": "decision",
            "default": "decision",
            "title": "Kind",
            "type": "string"
          },
          "trigger_kind": {
            "title": "Trigger Kind",
