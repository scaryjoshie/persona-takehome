          "new": {
            "title": "New",
            "type": "string"
          },
          "old": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Old"
          }
        },
        "required": ["kind", "slot", "new", "old"],
        "title": "SlotChanged",
