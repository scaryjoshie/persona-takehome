{
  "client_message": {
    "$defs": {
      "CallAction": {
        "enum": ["start", "accept", "decline", "hangup", "failed"],
        "title": "CallAction",
        "type": "string"
      },
      "CallCommand": {
        "properties": {
          "type": {
            "const": "call",
            "default": "call",
            "title": "Type",
            "type": "string"
          },
          "action": {
            "$ref": "#/$defs/CallAction"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reason"
          }
        },
        "required": ["type", "action", "reason"],
        "title": "CallCommand",
        "type": "object"
      },
      "Reset": {
        "properties": {
          "type": {
            "const": "reset",
            "default": "reset",
            "title": "Type",
            "type": "string"
          }
        },
        "required": ["type"],
        "title": "Reset",
        "type": "object"
      },
      "SendMessage": {
        "properties": {
          "type": {
            "const": "message",
            "default": "message",
            "title": "Type",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": ["type", "text"],
        "title": "SendMessage",
        "type": "object"
      },
      "SetTyping": {
        "properties": {
          "type": {
            "const": "typing",
            "default": "typing",
            "title": "Type",
            "type": "string"
          },
          "active": {
            "title": "Active",
            "type": "boolean"
          }
        },
        "required": ["type", "active"],
        "title": "SetTyping",
        "type": "object"
      }
    },
    "discriminator": {
      "mapping": {
        "call": "#/$defs/CallCommand",
        "message": "#/$defs/SendMessage",
        "reset": "#/$defs/Reset",
        "typing": "#/$defs/SetTyping"
      },
      "propertyName": "type"
    },
    "oneOf": [
      {
        "$ref": "#/$defs/SendMessage"
      },
      {
        "$ref": "#/$defs/SetTyping"
      },
      {
        "$ref": "#/$defs/CallCommand"
      },
      {
        "$ref": "#/$defs/Reset"
      }
    ]
  },
  "server_message": {
